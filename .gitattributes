# Скрипты для Linux (VPS) — всегда LF, иначе bash на сервере не прочитает их.
*.sh text eol=lf
server/deploy/Caddyfile text eol=lf
server/deploy/systemd/* text eol=lf

# Собранные файлы веб-версии (tool/web_assets.ps1) — как есть, без правки строк.
web/drift_worker.js -text -diff
web/sqlite3.wasm binary
# Зашифрованные файлы age (тесты расшифровки) — как есть, без перевода строк.
*.age binary
