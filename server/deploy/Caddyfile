# Реверс-прокси перед API. Сертификат Let's Encrypt Caddy получает и
# продлевает сам (данные — в томе caddy-data, не удалять: лимиты выдачи).
{$KFH_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	# Страница загрузки программы для телефона (этап 4.8): index.html и APK
	# из /opt/kfh/downloads. versions.json читает API (/client/version).
	redir /download /download/
	handle /download/* {
		root * /srv
		@apk path *.apk
		header @apk Content-Type application/vnd.android.package-archive
		header Cache-Control no-cache
		file_server
	}

	# Адрес клиента API берёт из X-Forwarded-For (TRUST_PROXY=true):
	# Caddy без trusted_proxies пишет туда только реальный адрес.
	reverse_proxy api:8080

	log {
		output stdout
		format json
	}
}
